# Copy to .env and override any value you want. All settings have sensible
# defaults in src/config.py — no secrets are required to run the pipeline.

# --- Storage ---
# DATA_DIR=data
# KEEP_AUDIO=false           # keep .ogg files after embedding

# --- Embedding (MERT) ---
# EMBED_MODEL=m-a-p/MERT-v1-95M
# TARGET_SR=24000
# CHUNK_SECONDS=30
# N_CHUNKS=3
# CHUNK_STRIDE=30
# EMBED_BATCH_SIZE=16
# EMBED_FLUSH_EVERY=50

# --- APIs ---
# ANIMETHEMES_PAGE_SIZE=100
# JIKAN_RATE_PER_SEC=3.0
# DOWNLOAD_WORKERS=8
# HTTP_TIMEOUT=60.0

# --- Recommender ---
# RECOMMEND_DEFAULT_MODE=discovery
# RECOMMEND_DEFAULT_K=20
# RECOMMEND_W_ANIME=0.1
# RECOMMEND_W_ARTIST=0.3
# RECOMMEND_W_ERA=0.05
# RECOMMEND_ERA_WINDOW_YEARS=2
# RECOMMEND_ALPHA_GENRE=0.3
# RECOMMEND_ALPHA_BLEND=0.3
# RECOMMEND_MAX_PER_ANIME=5
